func level3() -> void:
	var c := Canvas.new(400, 26)
	c.fill(0, 0, 1, 25)
	c.cx = 2
	var s := c.run(12, 20)
	c.put(s + 2, 19, "P")
	c.put(s + 6, 19, "1")
	s = c.run(12, 20)
	c.put(s + 8, 19, "m")
	c.embers(s + 1, s + 5, 18, 2)
	s = c.spike_pit(4, 21)
	s = c.run(10, 20)
	c.plat(s + 1, s + 4, 17)
	c.plat(s + 6, s + 9, 14)
	c.embers(s + 2, s + 3, 16, 1)
	c.embers(s + 7, s + 8, 13, 1)
	s = c.cx
	c.fill(s, 20, s + 2, 20, "x")
	c.fill(s + 4, 20, s + 6, 20, "x")
	c.fill(s + 8, 20, s + 10, 20, "x")
	c.embers(s + 1, s + 9, 18, 4)
	c.cx += 11
	s = c.run(10, 20)
	c.put(s + 2, 19, "C")
	c.put(s + 7, 19, "c")
	s = c.run(8, 17)
	c.put(s + 5, 16, "m")
	s = c.spike_pit(3, 19)
	var sh := c.run(14, 17)
	c.plat(sh + 9, sh + 11, 15)
	c.embers(sh + 2, sh + 7, 16, 5)
	var st := c.run(13, 13)
	# heart room inside the tall block, opened from the left at walking height
	c.secret_room(st + 1, 14, st + 5, 16)
	c.fill(st, 15, st, 16, "%")
	c.put(st + 3, 16, "H")
	c.put(st + 7, 9, "f")
	c.embers(st + 6, st + 11, 12, 2)
	s = c.run(10, 17)
	c.put(s + 4, 16, "m")
	c.put(s + 8, 16, "c")
	s = c.run(4, 17)
	c.fill(s, 16, s + 3, 16, "^")
	s = c.run(10, 17)
	c.put(s + 3, 16, "C")
	s = c.cx
	c.fill(s, 17, s + 2, 17, "x")
	c.fill(s + 5, 16, s + 7, 16, "x")
	c.put(s + 6, 14, "o")
	c.cx += 8
	s = c.run(12, 17)
	c.put(s + 3, 16, "m")
	c.put(s + 9, 16, "r")
	s = c.run(8, 15)
	c.plat(s + 1, s + 3, 12)
	c.plat(s + 5, s + 7, 9)
	c.put(s + 6, 8, "*")
	c.put(s + 2, 11, "o")
	s = c.run(10, 15)
	c.put(s + 6, 14, "E")
	c.embers(s + 1, s + 4, 14, 1)
	c.wall_right()
	c.save("res://levels/level_03.txt", {"name": "The Abandoned Village", "theme": "village", "music": "ruins", "heart": "1",
		"lore": "A child's drawing pinned to a door: a little flame, and the word 'home'."}, [
		"Ashen Sentries raise their blades before they lunge. Back off, then strike back.",
	])


