func level1() -> void:
	var c := Canvas.new(400, 24)
	c.fill(0, 0, 1, 23)
	c.cx = 2
	var s := c.run(16, 19)
	c.put(s + 2, 18, "P")
	c.put(s + 5, 18, "1")
	c.embers(s + 8, s + 14, 17)
	s = c.run(6, 18)
	c.put(s - 2, 18, "2")
	c.embers(s + 2, s + 4, 16)
	s = c.run(6, 16)
	c.embers(s + 1, s + 5, 14, 2)
	s = c.run(5, 14)
	c.put(s + 2, 12, "o")
	s = c.run(4, 17)
	c.put(s + 1, 16, "3")
	s = c.gap(3)
	c.put(s + 1, 14, "o")
	s = c.run(14, 17)
	c.put(s + 2, 16, "4")
	c.put(s + 9, 16, "c")
	c.embers(s + 5, s + 12, 15, 3)
	s = c.run(10, 17)
	c.put(s + 2, 16, "C")
	c.plat(s + 5, s + 8, 14)
	c.embers(s + 5, s + 8, 13, 3)
	var sj := c.run(8, 15)
	c.plat(sj + 1, sj + 4, 11)
	c.embers(sj + 1, sj + 4, 10)
	c.put(sj + 5, 14, "c")
	s = c.gap(3)
	c.embers(s, s + 2, 12)
	var su := c.run(21, 15)
	c.embers(su + 3, su + 11, 14, 4)
	# hidden room under the path, opened from the lower ledge to the right
	c.secret_room(su + 14, 16, su + 19, 18)
	c.fill(su + 20, 17, su + 20, 18, "%")
	c.put(su + 15, 18, "*")
	c.embers(su + 17, su + 19, 18)
	s = c.run(12, 19)
	c.put(s + 3, 18, "5")
	c.put(s + 8, 18, "c")
	s = c.run(5, 17)
	s = c.run(5, 15)
	c.embers(s + 1, s + 4, 14, 3)
	s = c.gap(3)
	c.put(s + 1, 12, "o")
	s = c.run(11, 15)
	c.put(s + 2, 14, "C")
	c.put(s + 7, 10, "f")
	s = c.run(16, 17)
	c.put(s + 6, 16, "c")
	c.put(s + 11, 16, "c")
	c.embers(s + 3, s + 13, 15, 5)
	s = c.run(10, 17)
	c.put(s + 6, 16, "E")
	c.wall_right()
	c.save("res://levels/level_01.txt", {"name": "The Forgotten Path", "theme": "path", "music": "calm",
		"lore": "A lantern-keeper's song: 'Keep the wick trimmed, and the dark keeps its distance.'"}, [
		"Hold LEFT or RIGHT to walk.",
		"Tap JUMP to jump. Hold JUMP to jump higher.",
		"Run and jump to cross gaps. Falling costs a flame.",
		"Tap ATTACK to strike. Hold ATTACK to keep swinging.",
		"Some walls are cracked. Strike them to find hidden places.",
	])


