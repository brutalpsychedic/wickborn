extends SceneTree
## Authoring tool: writes levels/level_XX.txt from the layouts below.
## Run:  godot --headless --path . --script res://tools/build_levels.gd
## The .txt files are the shipped data and can also be edited by hand (see levels/README.md);
## re-running this tool overwrites them.
##
## Design limits (measured with `--test=physics`): full jump ~4.2 tiles high, running jump
## ~5.4 tiles across. Layouts keep single-jump rises <= 3 and gaps <= 4, dash gaps <= 7,
## double-jump rises <= 5.


class Canvas:
	var w := 0
	var h := 0
	var rows: Array = []
	var cx := 0
	var overlays: Array = []

	func _init(width: int, height: int) -> void:
		w = width
		h = height
		for y in h:
			var r := PackedByteArray()
			r.resize(w)
			r.fill(46)
			rows.append(r)

	func setc(x: int, y: int, ch: String) -> void:
		if x >= 0 and y >= 0 and x < w and y < h:
			rows[y][x] = ch.unicode_at(0)

	func getc(x: int, y: int) -> String:
		if x >= 0 and y >= 0 and x < w and y < h:
			return String.chr(rows[y][x])
		return "#"

	func fill(x0: int, y0: int, x1: int, y1: int, ch: String = "#") -> void:
		for y in range(y0, y1 + 1):
			for x in range(x0, x1 + 1):
				setc(x, y, ch)

	func ground(x0: int, x1: int, top: int) -> void:
		fill(x0, top, x1, h - 1, "#")

	func roof(x0: int, x1: int, bottom: int) -> void:
		if bottom >= 0:
			fill(x0, 0, x1, bottom, "#")

	## Solid ground `len` wide with its top surface at row `top`. Returns the start column.
	func run(len: int, top: int, roof_bottom: int = -1) -> int:
		var s := cx
		ground(s, s + len - 1, top)
		roof(s, s + len - 1, roof_bottom)
		cx += len
		return s

	## Bottomless gap.
	func gap(len: int, roof_bottom: int = -1) -> int:
		var s := cx
		roof(s, s + len - 1, roof_bottom)
		cx += len
		return s

	## Pit with a spiked floor. `floor_top` = top row of the pit floor.
	func spike_pit(len: int, floor_top: int, roof_bottom: int = -1) -> int:
		var s := cx
		ground(s, s + len - 1, floor_top)
		fill(s, floor_top - 1, s + len - 1, floor_top - 1, "^")
		roof(s, s + len - 1, roof_bottom)
		cx += len
		return s

	## Pool of dark water from row `surface` down to the pit floor.
	func water_pit(len: int, surface: int, floor_top: int, roof_bottom: int = -1) -> int:
		var s := cx
		ground(s, s + len - 1, floor_top)
		fill(s, surface, s + len - 1, floor_top - 1, "~")
		roof(s, s + len - 1, roof_bottom)
		cx += len
		return s

	func plat(x0: int, x1: int, y: int) -> void:
		fill(x0, y, x1, y, "=")

	func put(x: int, y: int, ch: String) -> void:
		setc(x, y, ch)

	func embers(x0: int, x1: int, y: int, step: int = 2) -> void:
		var x := x0
		while x <= x1:
			if getc(x, y) == ".":
				setc(x, y, "o")
			x += step

	## Horizontal mover: platform centred on x (3 tiles wide) at row y travelling n tiles right.
	func mover_h(x: int, y: int, n: int) -> void:
		setc(x, y, "M")
		for i in n:
			setc(x + 1 + i, y, "-")

	## Vertical mover travelling n tiles up from row y.
	func mover_up(x: int, y: int, n: int) -> void:
		setc(x, y, "M")
		for i in n:
			setc(x, y - 1 - i, "|")

	## Hidden room: carve rows [y0..y1] x [x0..x1] inside solid ground and cover it.
	func secret_room(x0: int, y0: int, x1: int, y1: int) -> void:
		fill(x0, y0, x1, y1, ".")
		overlays.append([x0, y0, x1, y1])

	func wall_right() -> void:
		fill(cx, 0, cx + 1, h - 1, "#")
		cx += 2

	## Boss arena `len` wide with gates (4 tall) at both ends and walls above them.
	func arena(len: int, floor_top: int, roof_bottom: int) -> int:
		var s := cx
		ground(s, s + len - 1, floor_top)
		roof(s, s + len - 1, roof_bottom)
		for gx in [s, s + len - 1]:
			fill(gx, 0, gx, floor_top - 5, "#")
			fill(gx, floor_top - 4, gx, floor_top - 1, "G")
		cx += len
		return s

	func save(path: String, meta: Dictionary, signs: Array) -> void:
		var used_w := mini(w, cx)
		var f := FileAccess.open(path, FileAccess.WRITE)
		f.store_line("; Generated by tools/build_levels.gd - see levels/README.md for the legend.")
		f.store_line("[meta]")
		for k in meta:
			f.store_line("%s=%s" % [k, meta[k]])
		f.store_line("[signs]")
		for s in signs:
			f.store_line(String(s).replace("\n", "\\n"))
		if overlays.size() > 0:
			f.store_line("[overlay]")
			for o in overlays:
				f.store_line("%d,%d,%d,%d" % o)
		f.store_line("[map]")
		for y in h:
			var line := ""
			for x in used_w:
				line += String.chr(rows[y][x])
			f.store_line(line)
		f.close()
		print("wrote %s (%dx%d)" % [path, used_w, h])


func _init() -> void:
	level1()
	level2()
	level3()
	level4()
	level5()
	level6()
	level7()
	level8()
	level9()
	level10()
	quit()


